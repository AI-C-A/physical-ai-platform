# Browser-exposed Vite configuration
VITE_MAPBOX_ACCESS_TOKEN=pk.replace-with-your-public-mapbox-token
VITE_MAPBOX_STYLE_URL=mapbox://styles/your-mapbox-username/your-style-id

# Patrol integration gateway and camera smoke test
PATROL_ORIGIN=https://replace-with-your-patrol-origin.example.com
PATROL_API_KEY=replace-with-your-api-key
PATROL_API_SECRET=replace-with-your-api-secret
PATROL_CAMERA_CONFIG_PATH=/replace-with-your-camera-config-path
PATROL_ROBOTS_JSON=[{"id":"robot-01","serialNumber":"ROBOT-01","integrationProfileId":"patrol-rest-v1"}]
PATROL_ROBOT_SERIAL_NUMBER=ROBOT-01
PATROL_GATEWAY_PORT=8787
PATROL_STATUS_POLL_INTERVAL_MS=replace-with-approved-poll-interval-ms
PATROL_EVENT_BATTERY_LOW_THRESHOLD=replace-with-approved-battery-percent
