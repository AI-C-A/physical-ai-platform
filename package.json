{
  "name": "army-robot-platform-fe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "dev:mock": "npm run dev",
    "dev:real": "vite --configLoader runner --mode patrol --host --port 5173 --strictPort",
    "dev:funnel": "tailscale funnel 5173",
    "build": "npm run build:mock",
    "build:mock": "npm run typecheck && vite build --configLoader runner --mode mock",
    "build:real": "npm run typecheck && vite build --configLoader runner --mode patrol",
    "typecheck": "tsc -p tsconfig.app.json --noEmit --pretty false && tsc -p tsconfig.node.json --noEmit --pretty false && tsc -p tsconfig.e2e.json --noEmit --pretty false",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "check:design-system": "node scripts/check-design-system.mjs",
    "check:repository-safety": "node scripts/check-repository-safety.mjs",
    "test:unit": "vitest run --configLoader runner",
    "test:tools": "node --test scripts/*.test.mjs",
    "test:gateway": "node --test gateway/*.test.mjs",
    "test:segmentation": "node scripts/test-segmentation.mjs",
    "smoke:patrol-camera": "node --env-file-if-exists=.env.local scripts/patrol-camera-smoke.mjs",
    "segmentation:dev": "node scripts/run-segmentation.mjs",
    "gateway:dev": "node --env-file-if-exists=.env.local gateway/server.mjs",
    "gateway:quest": "node --env-file-if-exists=.env.local gateway/quest-server.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:soak": "npm run build && playwright test e2e/telemetry-video-soak.spec.ts --project=chrome-1440 --config=playwright.soak.config.ts",
    "verify": "npm run typecheck && npm run lint && npm run check:design-system && npm run check:repository-safety && npm run test:unit && npm run test:tools && npm run test:gateway && npm run test:segmentation",
    "verify:browser": "npm run test:e2e",
    "preview": "vite preview --configLoader runner"
  },
  "dependencies": {
    "@aws-sdk/client-kinesis-video-signaling": "3.1116.0",
    "@google/model-viewer": "^4.3.1",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "amazon-kinesis-video-streams-webrtc": "2.8.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "mapbox-gl": "^3.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.183.2",
    "zustand": "^5.0.15",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.183.1",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
